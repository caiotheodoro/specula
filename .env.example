# Modal — fill in locally; do not commit .env
MODAL_PROFILE=your-modal-profile
MODAL_ENV=plumb
MODAL_VOLUME=plumb-checkpoints

# Model
BASE_MODEL=Qwen/Qwen3.8-27B
BASE_MODEL_FALLBACK=Qwen/Qwen3.8-27B-FP8
FRONTIER_MODELS=Qwen/Qwen3.8-2.4T-A95B,deepseek-v4-flash
HF_TOKEN=

# GCP (fallback)
GCP_PROJECT=your-gcp-project
GCP_REGION=us-east1
GCP_ZONE=us-east1-b
GCP_MACHINE=n1-standard-4

# Training
SEED_TRAIN=7
SEED_BENCH=777
LORA_RANK=32
LORA_ALPHA=64
LORA_DROPOUT=0.05
QLORA_BITS=4
MAX_SEQ_LEN=4096
GRPO_G=8